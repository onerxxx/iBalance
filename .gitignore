# 用户配置：含真实 API Key / WorkBuddy token / 千问 ticket，严禁入库
# 注意只排除根目录这份；swift/config.json 是空 Key 模板，需要入库
/config.json

# 构建产物（可由 swift/build.sh 重新生成）
iBalance.app/
*.zip
swift/.build_state

# Python 缓存
__pycache__/

# macOS 杂项
.DS_Store

# WorkBuddy 本地工作记忆（含本机路径与过程记录，不入库）
.workbuddy/

# 编辑器/工具临时文件
*.swp
*~

# Cockpit Tools 源码参照（第三方本地副本，不入库）
cockpit-tools-main/

# 分发给用户的「已损坏」修复说明页，不入库
iBalance-已损坏说明.html

# SPM/swiftc 构建缓存
swift/.build/

# demo 编译产物（仅入库源码）
demo/GlassBackgroundPanelDemo
