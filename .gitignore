# 用户配置：含真实 API Key / WorkBuddy token / 千问 ticket / ZCode JWT，严禁入库
# 根目录与 swift/ 两份都不跟踪（swift/config.json 是 build.sh 的打包源，仅本地保留）；
# backups/ 内的根 config.json 副本同样含真实凭据，一并忽略（备份内的 swift/ 模板是空 Key，可留）
/config.json
/swift/config.json
backups/*/config.json

# 构建产物（可由 swift/build.sh 重新生成）
iBalance.app/
*.zip
swift/.build_state

# Python 缓存
__pycache__/

# macOS 杂项
.DS_Store

# WorkBuddy 本地工作记忆（含本机路径与过程记录，不入库）
.workbuddy/

# 编辑器/工具临时文件
*.swp
*~

# Cockpit Tools 源码参照（第三方本地副本，不入库）
cockpit-tools-main/

# 分发给用户的「已损坏」修复说明页，不入库
iBalance-已损坏说明.html

# SPM/swiftc 构建缓存
swift/.build/

# demo 编译产物（仅入库源码）
demo/GlassBackgroundPanelDemo
