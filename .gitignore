# 用户配置：含真实 API Key / WorkBuddy token / ZCode JWT，严禁入库
# swift/config.json 是 build.sh 的打包源，仅本地保留（根目录 config.json 已于 2026-08-20 移除，
# 保留 /config.json 规则防止误提交；backups/ 历史备份含真实凭据，整个目录不入库）
/config.json
/swift/config.json
/backups/

# 余额数值磁盘缓存（cache-then-refresh 启动秒显，运行时状态不入库）
/cache.json

# 构建产物（可由 swift/build.sh 重新生成）
iBalance.app/
*.zip
swift/.build_state

# Python 缓存
__pycache__/

# macOS 杂项
.DS_Store

# WorkBuddy 本地工作记忆（含本机路径与过程记录，不入库）
.workbuddy/

# 编辑器/工具临时文件
*.swp
*~

# Cockpit Tools 源码参照（第三方本地副本，含各版本目录，不入库）
cockpit-tools*/

# 分发给用户的「已损坏」修复说明页，不入库
iBalance-已损坏说明.html

# SPM/swiftc 构建缓存
swift/.build/
/.build/

# Impeccable 本地设计上下文（工具产物，不入库）
.impeccable.md

# Reasonix 本地工作状态（话题/剪贴板附件，不入库）
.reasonix/
reasonix.toml

# ZCode 本地会话计划（工具状态，不入库）
.zcode/

# Inter 字体发行包（完整 152 文件 / 59MB 分发版；app 仅用 swift/fonts/ 下精简子集，不入库）
Inter-4.1/

# codegraph 本机符号索引（守护进程自动重建，勿入库）
.codegraph/
